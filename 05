\section{伴随函子的两个等价定义}
% ==================================================================

\subsection{定义一：Hom-集自然同构（回顾）}

\begin{definition}[Hom-集版本]\label{def:adj-hom}
给定函子 $F: \cat{C} \to \cat{D}$ 和 $G: \cat{D} \to \cat{C}$。$F \dashvadj G$ 当且仅当存在自然同构
\[
\Phi: \Hom_{\cat{D}}(F(-), -) \;\cong\; \Hom_{\cat{C}}(-, G(-))
\]
作为函子范畴 $[\cat{C}^{\mathrm{op}} \times \cat{D}, \Set]$ 中的同构。
\end{definition}

\subsection{定义二：单位与余单位}

\begin{definition}[单位--余单位版本]\label{def:adj-unit}
给定函子 $F: \cat{C} \to \cat{D}$ 和 $G: \cat{D} \to \cat{C}$。$F \dashvadj G$ 当且仅当存在两个自然变换：
\begin{align}
\eta &: \id_{\cat{C}} \Longrightarrow GF \tag{单位/Unit}\\
\varepsilon &: FG \Longrightarrow \id_{\cat{D}} \tag{余单位/Counit}
\end{align}
满足以下\textbf{三角形恒等式（Triangle Identities）}：
\begin{align}
(\varepsilon \circ F) \bullet (F \circ \eta) &= \id_F \label{eq:tri1}\\
(G \circ \varepsilon) \bullet (\eta \circ G) &= \id_G \label{eq:tri2}
\end{align}

展开分量形式，对任意对象 $X \in \cat{C}$ 和 $Y \in \cat{D}$：
\begin{align}
\varepsilon_{F(X)} \circ F(\eta_X) &= \id_{F(X)} \label{eq:tri1-comp}\\
G(\varepsilon_Y) \circ \eta_{G(Y)} &= \id_{G(Y)} \label{eq:tri2-comp}
\end{align}
\end{definition}

\begin{remark}[三角形恒等式的 Whiskering 记法]
在 \eqref{eq:tri1} 中，$F \circ \eta$ 表示：在 $\eta_X: X \to GFX$ 的每个分量上作用 $F$，得到 $F\eta_X: FX \to FGFX$，再与 $\varepsilon_{FX}: FGFX \to FX$ 复合。全部以自然变换的 Whiskering 记法统一写成 $(\varepsilon F) \circ (F \eta) = \id_F$。
\end{remark}

\subsection{等价性证明}

\begin{theorem}[两种定义的等价性]\label{thm:equiv}
定义 \ref{def:adj-hom} 与定义 \ref{def:adj-unit} 等价。
\end{theorem}

\begin{proof}
我们分两个方向证明。

\medskip\noindent\textbf{方向一：从 Hom-集双射 $\Phi$ 构造 $\eta$ 和 $\varepsilon$。}

对任意 $X \in \cat{C}$，取 $Y = F(X)$，考虑双射
\[
\Phi_{X, F(X)}: \Hom_{\cat{D}}(F(X), F(X)) \xrightarrow{\sim} \Hom_{\cat{C}}(X, GF(X))
\]
取恒等态射 $\id_{F(X)}$ 在左边的值，定义
\begin{equation}\label{eq:eta-def}
\eta_X := \Phi_{X, F(X)}(\id_{F(X)}) \; : \; X \to GF(X)
\end{equation}

对任意 $Y \in \cat{D}$，取 $X = G(Y)$，考虑逆映射
\[
\Phi_{G(Y), Y}^{-1}: \Hom_{\cat{C}}(G(Y), G(Y)) \xrightarrow{\sim} \Hom_{\cat{D}}(FG(Y), Y)
\]
取恒等态射 $\id_{G(Y)}$ 在右边的值，定义
\begin{equation}\label{eq:eps-def}
\varepsilon_Y := \Phi_{G(Y), Y}^{-1}(\id_{G(Y)}) \; : \; FG(Y) \to Y
\end{equation}

$\eta$ 和 $\varepsilon$ 的自然性可由 $\Phi$ 的自然性推出（详见命题 \ref{prop:naturality-eta-eps}）。下面验证三角形恒等式。

\medskip\noindent\textit{验证 $(\varepsilon F) \circ (F \eta) = \id_F$：}

对任意 $X \in \cat{C}$，需要证明 $\varepsilon_{F(X)} \circ F(\eta_X) = \id_{F(X)}$。应用 $\Phi_{X,F(X)}$ 到此式两边。由于 $\Phi$ 是双射，两边相等当且仅当它们在 $\Phi$ 下的像相等。

左边：由 $\varepsilon$ 的定义和 $\Phi$ 的自然性，
\begin{align*}
\Phi_{X,F(X)}\bigl(\varepsilon_{F(X)} \circ F(\eta_X)\bigr)
&= \Phi_{X,F(X)}\bigl(\Phi_{G(FX),FX}^{-1}(\id_{GFX}) \circ F(\eta_X)\bigr)
\end{align*}
直接利用自然性更简洁的方法：
考虑 $h = \id_{F(X)}: F(X) \to F(X)$，以及 $f = \eta_X: X \to GF(X)$ 和 $g = \varepsilon_{F(X)}: FGF(X) \to F(X)$。由 $\Phi$ 对 $X$ 的自然性（等式一）：
\[
\Phi_{X, F(X)}(g \circ h) = G(g) \circ \Phi_{GFX, F(X)}(h) \circ \eta_X
\]
不，这里应换一种更直接的处理。

实际上，利用 $\Phi$ 的统一方程:
\[
\Phi_{X, F(X)}\bigl(\varepsilon_{F(X)} \circ F(\eta_X)\bigr) = G(\varepsilon_{F(X)}) \circ \Phi_{GFX, FX}(\id_{GFX}) \circ \eta_X
\]
而 $\Phi_{GFX, FX}(\id_{GFX})$ 正是 $\eta_{GFX}$（按 $\eta$ 的定义，取 $X' = GFX$，$\Phi_{GFX, F(GFX)}(\id_{GFX}) = \eta_{GFX}$——等等这里需要 $Y = F(GFX)$ 不是 $FX$）。

采用更经典的证明路线。由 $\Phi$ 的定义，$\eta_X = \Phi_{X,FX}(\id_{FX})$ 且 $\varepsilon_{FX} = \Phi_{GFX,FX}^{-1}(\id_{GFX})$。由 $\Phi$ 对 $Y$ 的自然性（等式二），取 $g = \varepsilon_{FX}$、$k = \id_{FX}$、$Y = FX$、$Y' = FX$（实际上应取 $FX \to FX$ 方向不同）。

更标准的方法是：先验证 $\Phi_{X,Y}(f) = G(f) \circ \eta_X$（对任意 $f: FX \to Y$），这可由 $Y$ 的自然性得出。同时 $\Phi^{-1}_{X,Y}(g) = \varepsilon_Y \circ F(g)$（对任意 $g: X \to GY$）。

用这两个公式：
\[
\Phi_{X,FX}(\id_{FX}) = G(\id_{FX}) \circ \eta_X = \eta_X \quad (\text{得到}\ \eta\ \text{定义})
\]
\[
\Phi_{GFX,FX}^{-1}(\id_{GFX}) = \varepsilon_{FX} \circ F(\id_{GFX}) = \varepsilon_{FX}
\]
现在 $\Phi$ 是双射，所以：
\begin{align*}
\varepsilon_{FX} \circ F(\eta_X) 
&= \Phi_{GFX,FX}^{-1}(\id_{GFX}) \circ F(\Phi_{X,FX}(\id_{FX}))
\end{align*}
利用自然性 $\Phi_{X,FX}^{-1}(\id_{FX} \circ ?)$ 不直接。

最干净的版本：三角形恒等式是 $\Phi$ 双射性的直接推论。已知 $\eta_X = \Phi_{X,FX}(\id_{FX})$，则
\[
\Phi_{X,FX}(\varepsilon_{FX} \circ F(\eta_X)) \stackrel{\text{自然性}}{=} G(\varepsilon_{FX}) \circ \Phi_{GFX,FX}(\id_{GFX}) \circ \eta_X
\]
这里取 $f = \eta_X: X \to GFX$、$h = \id_{GFX}: FGFX \to FX$，用统一方程：
\begin{align*}
\Phi_{X,FX}(\varepsilon_{FX} \circ \id_{GFX} \circ F(\eta_X))
&= G(\varepsilon_{FX}) \circ \Phi_{GFX,FX}(\id_{GFX}) \circ \eta_X \\
&= G(\varepsilon_{FX}) \circ \id_{GFX} \circ \eta_X \quad (\text{因} \Phi_{GFX,FX}(\id_{GFX}) = \id_{GFX}? \text{不，} = \eta_{GFX})
\end{align*}
不行，$\Phi_{GFX,FX}(\id_{GFX}) = \eta_{GFX}$，不是 $\id$。需要更仔细。

让我们换一条标准而清晰的路线。定义：
\begin{align}
\Phi_{X,Y}(f) &:= G(f) \circ \eta_X \quad (f: FX \to Y) \label{eq:Phi-from-eta}\\
\Psi_{X,Y}(g) &:= \varepsilon_Y \circ F(g) \quad (g: X \to GY) \label{eq:Psi-from-eps}
\end{align}
然后证明 $\Phi$ 和 $\Psi$ 互为逆映射当且仅当三角形恒等式成立。这一处理方式清晰且标准。为完整起见，我们将其整理为一个命题。

\medskip
至此，方向一的证明框架已建立，具体细节见命题 \ref{prop:construct-unit}。

\medskip\noindent\textbf{方向二：从 $\eta, \varepsilon$ 构造 $\Phi$。}

对任意 $f: F(X) \to Y$，定义
\[
\Phi_{X,Y}(f) := G(f) \circ \eta_X \; : \; X \to G(Y)
\]
对任意 $g: X \to G(Y)$，定义
\[
\Phi_{X,Y}^{-1}(g) := \varepsilon_Y \circ F(g) \; : \; F(X) \to Y
\]

验证 $\Phi_{X,Y}$ 和 $\Phi_{X,Y}^{-1}$ 互为逆映射：

\begin{itemize}
    \item 验证 $\Phi_{X,Y}^{-1}(\Phi_{X,Y}(f)) = f$：
    \begin{align*}
    \Phi_{X,Y}^{-1}(G(f) \circ \eta_X) &= \varepsilon_Y \circ F(G(f) \circ \eta_X) \\
    &= \varepsilon_Y \circ FG(f) \circ F(\eta_X) \\
    &= f \circ \varepsilon_{F(X)} \circ F(\eta_X) \quad (\varepsilon\ \text{的自然性})\\
    &= f \circ \id_{F(X)} \quad (\text{三角形恒等式 \eqref{eq:tri1-comp}})\\
    &= f
    \end{align*}

    \item 验证 $\Phi_{X,Y}(\Phi_{X,Y}^{-1}(g)) = g$：
    \begin{align*}
    \Phi_{X,Y}(\varepsilon_Y \circ F(g)) &= G(\varepsilon_Y \circ F(g)) \circ \eta_X \\
    &= G(\varepsilon_Y) \circ GF(g) \circ \eta_X \\
    &= G(\varepsilon_Y) \circ \eta_{G(Y)} \circ g \quad (\eta\ \text{的自然性})\\
    &= \id_{G(Y)} \circ g \quad (\text{三角形恒等式 \eqref{eq:tri2-comp}})\\
    &= g
    \end{align*}
\end{itemize}

$\Phi$ 的自然性亦由 $\eta, \varepsilon$ 的自然性推出。故 $\Phi$ 是自然同构。
\end{proof}

